# Inner Caddy: serves the built bundle. TLS and the public hostname are the
# host Caddy's job, so this listens plain on 8080.
:8080 {
	root * /srv
	encode gzip zstd

	# Assets are handled separately from the SPA fallback on purpose. With a
	# blanket `try_files {path} /index.html`, a missing or renamed chunk comes
	# back 200 with an HTML body, and the browser fails on "unexpected token
	# <" somewhere unrelated. Here a missing asset is a plain 404, which says
	# what actually went wrong. Vite content-hashes these, so they cache hard.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single page. index.html must not be cached, or a
	# deploy never reaches anyone still holding the old one.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
